{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "*": "deny",
    "bash": {
      "*": "ask",
      "printf *": "allow",
      "pwd": "allow",
      "ls*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "node --version": "allow",
      "npm test*": "allow",
      "* | *": "ask",
      "*|*": "ask",
      "* ; *": "ask",
      "*;*": "ask",
      "* && *": "ask",
      "*&&*": "ask",
      "* || *": "ask",
      "*||*": "ask",
      "* > *": "ask",
      "*>*": "ask",
      "* < *": "ask",
      "*<*": "ask",
      "git reset --hard*": "deny",
      "git clean*": "deny"
    },
    "read": "allow"
  }
}
